# ---------- Server ----------
PORT=3001
NODE_ENV=development
# Public origin of the storefront (scheme + hostname, no path). Production requires
# the exact public HTTPS origin, e.g. https://store.example.com (a trailing slash is okay).
# Set this separately for Vercel Production and Preview environments; previews are not
# implicitly trusted. Used for origin validation and payment return links.
APP_URL=http://localhost:5173
# PostgreSQL connection string from your database provider (server-only).
# Add sslmode=require if required by your provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Local SQLite source used only by the one-time import command.
LEGACY_DB_PATH=./data/novashop.db
UPLOAD_DIR=./data/uploads
# REQUIRED in production: a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Admin account, created on first run.
# In production set a strong ADMIN_PASSWORD (minimum 12 characters).
ADMIN_EMAIL=admin@novashop.test
ADMIN_PASSWORD=change-me-strong-password
# Optional demo payment safety flag: requires explicit enablement and is blocked in production unless set true.
PAYMENTS_DEMO_MODE=false
# Demo customers, orders and sales history. Defaults to true in development, false in production.
SEED_DEMO_DATA=true
# Prices are stored in USD. M-Pesa charges KES at this rate.
KES_PER_USD=129

# ---------- Card payments (Stripe Checkout) ----------
# Leave empty for demo mode: no card is charged and the order is marked paid.
STRIPE_SECRET_KEY=
# Webhook endpoint: POST {your-domain}/api/stripe/webhook  (events: checkout.session.completed / expired)
STRIPE_WEBHOOK_SECRET=

# ---------- M-Pesa (Safaricom Daraja STK push) ----------
# Leave empty for demo mode: the order confirms after a few seconds
# (a phone number ending in 0000 simulates a cancelled prompt).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS URL Safaricom can reach, e.g. https://your-domain.com/api/mpesa/callback
MPESA_CALLBACK_URL=
