{
  "name": "novashop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit -p server && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "db:seed": "tsx server/seed.ts --reset",
    "db:catalog": "tsx server/seed.ts --catalog",
    "typecheck": "tsc --noEmit -p server",
    "test": "tsx --test server/tests/*.test.ts",
    "db:init": "tsx server/init-db.ts",
    "db:import-sqlite": "tsx server/import-sqlite.ts",
    "db:sync-admin": "tsx server/sync-admin.ts",
    "db:remove-demo-orders": "tsx server/remove-demo-orders.ts"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.1.0",
    "@tanstack/react-query": "^5.59.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.453.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "stripe": "^17.3.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.8.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.0.1",
    "pg-mem": "^3.0.14",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
